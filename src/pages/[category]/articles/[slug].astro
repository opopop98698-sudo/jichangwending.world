---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import contentMap from '../../../data/content-map.json';
import brandsData from '../../../data/brands.json';
import { getAffiliateLink } from '../../../lib/links';
import { TOPIC_KNOWLEDGE_BASE } from '../../../lib/topicKnowledgeEngine';

// Interactive Tools
import RequirementSelector from '../../../components/tools/RequirementSelector.astro';
import BrandFilter from '../../../components/tools/BrandFilter.astro';
import TwoBrandCompare from '../../../components/tools/TwoBrandCompare.astro';
import BandwidthConverter from '../../../components/tools/BandwidthConverter.astro';
import BillingCycleComparator from '../../../components/tools/BillingCycleComparator.astro';
import MetricCalculator from '../../../components/tools/MetricCalculator.astro';
import TroubleshootTree from '../../../components/tools/TroubleshootTree.astro';
import NetworkPathDiagram from '../../../components/NetworkPathDiagram.astro';

export async function getStaticPaths() {
  return contentMap.map((article) => {
    const category = article.parentRoute.replace(/\//g, '');
    const slug = article.id.toLowerCase();
    return {
      params: { category, slug },
      props: { article }
    };
  });
}

const { article } = Astro.props;

// Fetch deep technical module for this topic
const knowledge = TOPIC_KNOWLEDGE_BASE[article.parentTopicId] || TOPIC_KNOWLEDGE_BASE['R01'];

// Find sibling articles in the same cluster
const siblingArticles = contentMap.filter(
  (a) => a.clusterId === article.clusterId && a.id !== article.id
);

// Intelligent Brand Conversion Matching
const targetBrandIds = (knowledge.conversionAdvice?.recommendedBrandIds && knowledge.conversionAdvice.recommendedBrandIds.length > 0)
  ? knowledge.conversionAdvice.recommendedBrandIds
  : ['lightspeed', 'feimao'];

// Priority: mapped entities in article -> knowledge advice -> top editorial brands
let matchedBrands = brandsData.filter((b) =>
  article.relatedEntities && article.relatedEntities.includes(b.id)
);
if (matchedBrands.length === 0) {
  matchedBrands = brandsData.filter((b) => targetBrandIds.includes(b.id));
}
if (matchedBrands.length < 2) {
  for (const b of brandsData) {
    if (!matchedBrands.find((x) => x.id === b.id)) {
      matchedBrands.push(b);
      if (matchedBrands.length >= 2) break;
    }
  }
}
const displayBrands = matchedBrands.slice(0, 2);

const pageTitle = `${article.title} - 稳定机场指南深度技术白皮书`;
const pageDescription = `针对“${article.primaryQuestion}”的深度网络工程与实操解答。结合${knowledge.engineeringDepth}，解析三大运营商骨干网路由（电信/联通/移动）、${knowledge.mathematicalModel.formulaName}、抓包排障诊断与防坑选购依据。`;

// 4 High-depth FAQs for Schema & UI
const articleFaqs = [
  {
    q: `如何针对本专题“${article.title}”在本地执行快速网络工程定界？`,
    a: `建议采用五层逐级排查模型：首先验证本地客户端（如 Clash Verge / Sing-box）的系统代理监听（127.0.0.1:7890）与 TUN 虚拟网卡驱动状态；其次在本地终端使用 MTR 或 ping 发送 50 组连续探测包，判定光猫及本地宽带最后一公里的延迟抖动（标准差 StDev 需 < 2ms）；再核对国内 BGP 入口与跨境专线链路；最后检查境外落地节点的 IP 纯净度与 ASN 风控得分。`
  },
  {
    q: `针对“${article.primaryQuestion}”，三大运营商（电信/联通/移动）的底层表现有何根本区别？`,
    a: `中国电信主要受 AS4134（163骨干网）晚高峰公网海缆出口重度拥塞影响，非 CN2 GIA/物理专线链路易出现 15%-30% 突发丢包；中国联通（AS4837/AS9929）国际出口互联相对宽裕，北方用户延迟占优但跨网存在省际跳数；中国移动（AS9808/CMI）华南方向带宽充足，但针对境外大流量 UDP 及无混淆长连接易触发深度包检测（DPI）与 QoS 限速。`
  },
  {
    q: `本专题涉及的“${knowledge.mathematicalModel.formulaName}”如何指导实际选购与稳定性评估？`,
    a: `该数学模型明确指出：在跨境高延迟链路（RTT 通常在 80ms-200ms）下，网络吞吐性能并非仅取决于商家宣传的几百兆带宽上限，而是受到链路丢包率与 TCP 拥塞控制算法窗口回退的强约束。微小的 1% 物理丢包即可导致 TCP 吞吐骤降 80% 以上。因此优先选择晚高峰丢包稳定低于 0.5% 的真实专线，比单纯追求千兆跑分具备更高的实际生产力价值。`
  },
  {
    q: `如何根据本站证据标准，核验目标节点是真实物理专线（IEPL/IPLC）还是普通公网中转伪装？`,
    a: `最直接的证据特征在于晚高峰（20:00-23:30）持续 MTR 探测：真实内网专线由于不经过公网国际海缆出口，其网络抖动标准差（StDev）通常 < 1.5ms 且丢包率为 0%；若在晚高峰出现延迟跳涨 50ms 以上、或者 ping 出口路由出现公网骨干网节点与重度丢包，则属于公网中转假冒专线。`
  }
];

const articleSchema = [
  {
    '@type': 'Article',
    headline: article.title,
    description: pageDescription,
    url: `https://jichangwending.world${article.suggestedUrl}`,
    datePublished: '2026-10-20T08:00:00+08:00',
    dateModified: '2026-10-21T10:00:00+08:00',
    publisher: {
      '@type': 'Organization',
      name: '稳定机场指南评测实验室',
      url: 'https://jichangwending.world'
    },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://jichangwending.world/' },
        { '@type': 'ListItem', position: 2, name: article.parentCategory, item: `https://jichangwending.world${article.parentRoute}` },
        { '@type': 'ListItem', position: 3, name: `${article.parentTopicName} · ${article.clusterName}`, item: `https://jichangwending.world${article.suggestedUrl}` },
        { '@type': 'ListItem', position: 4, name: article.title, item: `https://jichangwending.world${article.suggestedUrl}` }
      ]
    }
  },
  {
    '@type': 'FAQPage',
    mainEntity: articleFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a
      }
    }))
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`https://jichangwending.world${article.suggestedUrl}`}
  schema={articleSchema}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center space-x-2 text-xs font-mono text-obs-muted overflow-x-auto whitespace-nowrap pb-1">
      <a href="/" class="hover:text-obs-text transition">首页</a>
      <span>/</span>
      <a href={article.parentRoute} class="hover:text-obs-text transition">{article.parentCategory}</a>
      <span>/</span>
      <span class="text-obs-muted">{article.parentTopicName}</span>
      <span>/</span>
      <span class="text-sky-400 truncate max-w-[200px]">{article.clusterName}</span>
    </nav>

    <!-- Header Section -->
    <header class="rounded-2xl border border-obs-border bg-gradient-to-b from-obs-panel to-obs-bg p-6 sm:p-8 space-y-4">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="px-2.5 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20 font-bold">
          {article.id} · 三级技术白皮书
        </span>
        <span class="px-2 py-0.5 rounded bg-purple-500/10 text-purple-300 border border-purple-500/20">
          层级: {knowledge.networkLayer}
        </span>
        <span class="px-2 py-0.5 rounded bg-obs-bg text-obs-muted border border-obs-border">
          集群: {article.clusterName}
        </span>
        <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          意图: {article.searchIntent}
        </span>
      </div>

      <h1 class="text-xl sm:text-3xl font-extrabold tracking-tight text-obs-text leading-tight">
        {article.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-obs-muted pt-1">
        <span>文献模型: {knowledge.engineeringDepth}</span>
        <span>•</span>
        <span>阅读耗时: 约 12-15 分钟</span>
        <span>•</span>
        <span class="text-emerald-400">核验依据: {article.requiredEvidence}</span>
      </div>

      <div class="p-3.5 rounded-lg bg-obs-bg border border-obs-border/70 text-xs sm:text-sm text-obs-text leading-relaxed">
        <span class="font-bold text-sky-400 font-mono">核心工程问题：</span>
        <span>{article.primaryQuestion}</span>
      </div>
    </header>

    <!-- 1. Answer-First Core Answer Box -->
    <section class="rounded-xl border border-sky-500/40 bg-sky-500/5 p-6 sm:p-7 space-y-4">
      <div class="flex items-center gap-2 text-sky-400 font-bold text-sm">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
        <h2 class="text-sm font-bold tracking-wider uppercase font-mono">结论先行与工程定界 (Answer-First Executive Summary)</h2>
      </div>

      <div class="text-xs sm:text-sm text-obs-text leading-relaxed space-y-3">
        <p>
          针对<strong>“{article.primaryQuestion}”</strong>，核心工程论断为：<strong>单次测速峰值不代表链路真实服务质量（QoS），高可用代理体验的关键在于“晚高峰物理丢包率（Packet Loss）与抖动标准差（StDev）”的双重收敛</strong>。任何宣称“万兆秒开”但无法提供晚高峰连续发包样本的商家，均存在严重的超售回退风险。
        </p>
        <p class="text-obs-muted">
          在网络工程标准排障实践中，任何访问异常或选型决策必须严格基于<strong>“五层网络链路定界模型”</strong>：
        </p>

        <!-- 5-Layer Network Diagnostic Bounding -->
        <div class="grid grid-cols-1 sm:grid-cols-5 gap-2 text-xs font-mono pt-2">
          <div class="p-2.5 rounded bg-obs-panel border border-obs-border text-center">
            <div class="text-sky-400 font-bold">L1 本地环境</div>
            <div class="text-[10px] text-obs-muted mt-1">内核/TUN网卡/系统代理</div>
          </div>
          <div class="p-2.5 rounded bg-obs-panel border border-obs-border text-center">
            <div class="text-indigo-400 font-bold">L2 接入骨干</div>
            <div class="text-[10px] text-obs-muted mt-1">光猫MTU/最后一公里接入</div>
          </div>
          <div class="p-2.5 rounded bg-obs-panel border border-obs-border text-center">
            <div class="text-purple-400 font-bold">L3 国内入口</div>
            <div class="text-[10px] text-obs-muted mt-1">多线BGP/省际跳数调度</div>
          </div>
          <div class="p-2.5 rounded bg-obs-panel border border-obs-border text-center">
            <div class="text-emerald-400 font-bold">L4 跨境专线</div>
            <div class="text-[10px] text-obs-muted mt-1">IEPL/IPLC内网 vs 公网海缆</div>
          </div>
          <div class="p-2.5 rounded bg-obs-panel border border-obs-border text-center">
            <div class="text-amber-400 font-bold">L5 境外落地</div>
            <div class="text-[10px] text-obs-muted mt-1">IDC信誉/反爬风控策略</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 1.5. Article-Specific Core Engineering Analysis & Evidence Benchmark -->
    <section class="space-y-4">
      <div class="border-b border-obs-border pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-indigo-400 rounded-sm"></span>
          专题实战证据链与量化核验基准 ({article.id})
        </h2>
        <span class="text-xs font-mono text-indigo-400">核验依据：{article.requiredEvidence}</span>
      </div>

      <div class="p-5 sm:p-6 rounded-xl bg-obs-panel border border-obs-border space-y-4 text-xs sm:text-sm text-obs-muted leading-relaxed">
        <div class="space-y-2">
          <h3 class="text-sm font-bold text-obs-text">
            一、围绕【{article.targetKeyword}】的核心痛点工程剖析
          </h3>
          <p>
            用户在面对<strong>“{article.primaryQuestion}”</strong>这一实际挑战时，最常陷入的误区是<strong>“将商家的宣传文案等同于物理现实”</strong>。在跨境代理网络架构中，影响该问题的核心变量并非单一指标，而是涉及本地客户端配置、运营商路由对等与海外机房落地属性的复合链条。
          </p>
          <p>
            针对当前专题集群<strong>【{article.clusterName}】</strong>，必须建立<strong>以可复现测试数据为核心的客观评价标准</strong>。如果某个节点在测速软件中显示 1000Mbps，但持续连续发包丢包率超过 2%，在实际使用中就会频繁遭遇 TCP 拥塞控制降速、流媒体缓冲转圈或网页首包长时间卡死。
          </p>
        </div>

        <div class="pt-2">
          <h3 class="text-sm font-bold text-obs-text mb-3">
            二、专题量化检验基准与合格阈值对照表
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono border border-obs-border rounded-lg overflow-hidden">
              <thead class="bg-obs-bg text-obs-text">
                <tr class="border-b border-obs-border">
                  <th class="py-2.5 px-3">测试核验维度</th>
                  <th class="py-2.5 px-3">对应证据类型</th>
                  <th class="py-2.5 px-3">工程合格阈值 (Pass)</th>
                  <th class="py-2.5 px-3">异常风险预警 (Fail)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-obs-border/60">
                <tr class="hover:bg-obs-bg/40">
                  <td class="py-2 px-3 text-obs-text font-bold">晚高峰丢包率 (Packet Loss)</td>
                  <td class="py-2 px-3 text-sky-400">{article.requiredEvidence}</td>
                  <td class="py-2 px-3 text-emerald-400">&le; 0.5% (连续 100 包)</td>
                  <td class="py-2 px-3 text-rose-400">&gt; 2.0% (TCP 剧烈降速)</td>
                </tr>
                <tr class="hover:bg-obs-bg/40">
                  <td class="py-2 px-3 text-obs-text font-bold">往返延迟抖动标准差 (StDev)</td>
                  <td class="py-2 px-3 text-sky-400">MTR 统计报告</td>
                  <td class="py-2 px-3 text-emerald-400">&le; 2.5 ms</td>
                  <td class="py-2 px-3 text-rose-400">&gt; 15.0 ms (严重微抖动)</td>
                </tr>
                <tr class="hover:bg-obs-bg/40">
                  <td class="py-2 px-3 text-obs-text font-bold">首包响应时间 (TTFB)</td>
                  <td class="py-2 px-3 text-sky-400">cURL 握手时间戳</td>
                  <td class="py-2 px-3 text-emerald-400">&le; 180 ms</td>
                  <td class="py-2 px-3 text-rose-400">&gt; 500 ms (首屏卡顿)</td>
                </tr>
                <tr class="hover:bg-obs-bg/40">
                  <td class="py-2 px-3 text-obs-text font-bold">落地出口信誉 (Fraud Score)</td>
                  <td class="py-2 px-3 text-sky-400">IP 属性库检测</td>
                  <td class="py-2 px-3 text-emerald-400">&le; 25 分 (纯净机房/原生)</td>
                  <td class="py-2 px-3 text-rose-400">&gt; 65 分 (易遭 403 封锁)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. ISP 3-Carrier Routing Analysis -->
    <section class="space-y-4">
      <div class="border-b border-obs-border pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-sky-400 rounded-sm"></span>
          三大运营商骨干网路由实测表现 (3-ISP Routing Architecture)
        </h2>
        <span class="text-xs font-mono text-obs-muted">基于 AS4134 / AS4837 / AS9808 实测拓扑</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs leading-relaxed">
        <!-- Telecom -->
        <div class="p-4 rounded-xl bg-obs-panel border border-obs-border space-y-2">
          <div class="flex items-center justify-between border-b border-obs-border/70 pb-2">
            <span class="font-bold text-sky-400">中国电信 (China Telecom)</span>
            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-300">AS4134 / AS4809</span>
          </div>
          <p class="text-obs-muted text-xs">
            {knowledge.ispRoutingAnalysis.telecom}
          </p>
          <div class="pt-2 text-[11px] font-mono text-obs-text/80 bg-obs-bg p-2 rounded">
            建议策略：必须搭配专线 BGP 华东/华南中转入口；普通公网直连晚高峰建议切换 BBR 拥塞算法。
          </div>
        </div>

        <!-- Unicom -->
        <div class="p-4 rounded-xl bg-obs-panel border border-obs-border space-y-2">
          <div class="flex items-center justify-between border-b border-obs-border/70 pb-2">
            <span class="font-bold text-emerald-400">中国联通 (China Unicom)</span>
            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-300">AS4837 / AS9929</span>
          </div>
          <p class="text-obs-muted text-xs">
            {knowledge.ispRoutingAnalysis.unicom}
          </p>
          <div class="pt-2 text-[11px] font-mono text-obs-text/80 bg-obs-bg p-2 rounded">
            建议策略：北方用户优先接入北京/山东骨干节点；针对日本及美西直连线路具有天然 RTT 延迟优势。
          </div>
        </div>

        <!-- Mobile -->
        <div class="p-4 rounded-xl bg-obs-panel border border-obs-border space-y-2">
          <div class="flex items-center justify-between border-b border-obs-border/70 pb-2">
            <span class="font-bold text-purple-400">中国移动 (China Mobile)</span>
            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-300">AS9808 / AS58453</span>
          </div>
          <p class="text-obs-muted text-xs">
            {knowledge.ispRoutingAnalysis.mobile}
          </p>
          <div class="pt-2 text-[11px] font-mono text-obs-text/80 bg-obs-bg p-2 rounded">
            建议策略：华南方向（广东中转经香港出口）性能最佳；避免纯明文协议以防遭遇本地局端 QoS 限速。
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Mathematical Model & Derivation -->
    <section class="space-y-4">
      <div class="border-b border-obs-border pb-3 flex items-center justify-between">
        <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-emerald-400 rounded-sm"></span>
          数学定量推导与传输效能模型 ({knowledge.mathematicalModel.formulaName})
        </h2>
        <span class="text-xs font-mono text-obs-muted">RFC 2581 / Mathis Derivation</span>
      </div>

      <div class="p-6 rounded-xl bg-obs-panel border border-obs-border space-y-4">
        <!-- KaTeX Math Equation Presentation Box -->
        <div class="text-center py-4 px-6 rounded-lg bg-obs-bg border border-obs-border font-mono text-sm sm:text-base text-sky-400 overflow-x-auto">
          <div class="text-xs text-obs-muted mb-2 font-sans">【数学公式推导形式】</div>
          <div class="font-bold tracking-wider text-base sm:text-lg">
            {knowledge.mathematicalModel.formulaKatex}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div class="space-y-2 bg-obs-bg/60 p-4 rounded-lg border border-obs-border/60">
            <div class="font-bold text-obs-text font-mono text-xs">参数变量工程解释：</div>
            <p class="text-obs-muted leading-relaxed">
              {knowledge.mathematicalModel.explanation}
            </p>
          </div>
          <div class="space-y-2 bg-obs-bg/60 p-4 rounded-lg border border-obs-border/60">
            <div class="font-bold text-obs-text font-mono text-xs">实战定量测算案例：</div>
            <p class="text-obs-muted leading-relaxed">
              {knowledge.mathematicalModel.practicalExample}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Packet Capture & Deep Hex Dissection -->
    <section class="space-y-4">
      <div class="border-b border-obs-border pb-3 flex items-center justify-between">
        <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-purple-400 rounded-sm"></span>
          底层抓包剖析与协议特征诊断 (Wireshark / tcpdump Dissection)
        </h2>
        <span class="text-xs font-mono text-purple-400">{knowledge.packetCaptureAnalysis.protocol}</span>
      </div>

      <div class="space-y-3">
        <div class="text-xs text-obs-muted leading-relaxed">
          采用诊断工具捕获握手阶段特征，深入分析 TCP SYN/ACK 重传、TLS Client Hello 拓展（SNI/ALPN）以及异常 RST 阻断：
        </div>

        <!-- Terminal Diagnostic Snippet -->
        <div class="rounded-xl border border-obs-border bg-[#070D18] p-4 font-mono text-xs overflow-x-auto space-y-2">
          <div class="text-[10px] text-obs-muted flex items-center justify-between border-b border-obs-border/40 pb-1.5">
            <span>PACKET CAPTURE CLI COMMAND</span>
            <span class="text-sky-400">PROT: {knowledge.packetCaptureAnalysis.protocol}</span>
          </div>
          <div class="text-emerald-400 select-all">
            $ {knowledge.packetCaptureAnalysis.diagnosticSnippet}
          </div>
        </div>

        <!-- Hex Dump Analysis -->
        <div class="rounded-xl border border-obs-border bg-[#070D18] p-4 font-mono text-xs overflow-x-auto space-y-2">
          <div class="text-[10px] text-obs-muted flex items-center justify-between border-b border-obs-border/40 pb-1.5">
            <span>RAW PACKET HEX DUMP (L3/L4/L7 HEADERS)</span>
            <span class="text-amber-400">OFFSET / HEX / ASCII</span>
          </div>
          <pre class="text-obs-muted text-[11px] leading-tight select-all">{knowledge.packetCaptureAnalysis.hexSummary}</pre>
        </div>
      </div>
    </section>

    <!-- 5. Multi-OS CLI Command Suite -->
    <section class="space-y-4">
      <div class="border-b border-obs-border pb-3 flex items-center justify-between">
        <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-amber-400 rounded-sm"></span>
          跨平台终端排障实操指令集 (Multi-OS Diagnostic Suite)
        </h2>
        <span class="text-xs font-mono text-obs-muted">PowerShell & Bash 脚本</span>
      </div>

      <div class="space-y-3">
        {knowledge.cliCommandSuite.map((item, idx) => (
          <div class="rounded-xl border border-obs-border bg-obs-panel p-4 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <span class="font-bold text-obs-text flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <span>{item.purpose}</span>
              </span>
              <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-obs-bg border border-obs-border text-obs-muted">
                {item.os}
              </span>
            </div>

            <!-- Command block -->
            <div class="rounded-lg bg-[#070D18] p-3 font-mono text-xs text-sky-300 border border-obs-border/70 overflow-x-auto select-all">
              {item.command}
            </div>

            <!-- Expected Output -->
            <div class="rounded-lg bg-obs-bg/60 p-3 font-mono text-[11px] text-obs-muted border border-obs-border/40 overflow-x-auto">
              <div class="text-[10px] text-emerald-400 font-bold mb-1 font-sans">预期标准输出 (Expected Output)：</div>
              <pre class="leading-tight">{item.expectedOutput}</pre>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. 4-Phase Lifecycle Actionable SOP -->
    <section class="space-y-4">
      <div class="border-b border-obs-border pb-3 flex items-center justify-between">
        <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-sky-400 rounded-sm"></span>
          全生命周期标准化处置 SOP (Standard Operating Procedure)
        </h2>
        <span class="text-xs font-mono text-obs-muted">四阶段闭环处置</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {knowledge.stepByStepSOP.map((sop, idx) => (
          <div class="p-4 rounded-xl bg-obs-panel border border-obs-border space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-sky-400">{sop.phase}</span>
              <span class="text-[10px] font-mono text-obs-muted">STEP 0{idx + 1}</span>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-obs-text">{sop.title}</h3>
            <div class="text-xs text-obs-muted space-y-1.5 pt-1">
              <p><strong class="text-obs-text">核心动作：</strong>{sop.action}</p>
              <div class="p-2 rounded bg-obs-bg border border-obs-border/60 text-[11px] text-emerald-400 font-mono">
                验证指标：{sop.verification}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 7. High-Conversion Contextual Brand Recommendations -->
    <section class="rounded-2xl border-2 border-sky-500/30 bg-gradient-to-b from-sky-500/5 via-obs-panel to-obs-bg p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-obs-border/80 pb-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono font-bold mb-1">
            <span>精准选型方案</span>
            <span>•</span>
            <span>实测数据对标</span>
          </div>
          <h2 class="text-base sm:text-xl font-bold text-obs-text">
            针对【{article.title}】的实测匹配方案
          </h2>
        </div>
        <a href="/brands/" class="text-xs font-mono text-sky-400 hover:underline">
          查阅全部 41 个品牌档案 &rarr;
        </a>
      </div>

      <div class="text-xs text-obs-muted leading-relaxed">
        <strong>选型依据与逻辑：</strong>{knowledge.conversionAdvice.selectionLogic}
        <span class="block mt-1 text-amber-400 font-mono">提示：{knowledge.conversionAdvice.budgetWarning}</span>
      </div>

      <!-- Recommendation Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {displayBrands.map((b) => {
          const aff = getAffiliateLink(b.id);
          const maxSpeed = b.speedTest?.results?.reduce((max, r) => Math.max(max, r.downloadMbps || 0), 0) || 0;
          return (
            <div class="p-5 rounded-xl border border-obs-border bg-obs-panel hover:border-sky-500/50 transition space-y-4 flex flex-col justify-between shadow-lg">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div>
                    <a href={`/brands/${b.id}/`} class="text-base font-bold text-obs-text hover:text-sky-300">
                      {b.name}
                    </a>
                    <div class="text-[10px] text-obs-muted font-mono">{b.id} · 编辑推荐池</div>
                  </div>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20 truncate max-w-[130px]">
                    {b.lineType.split('（')[0]}
                  </span>
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs font-mono bg-obs-bg p-3 rounded-lg border border-obs-border/70">
                  <div>
                    <span class="text-[10px] text-obs-muted block">起步价格</span>
                    <span class="text-obs-text font-bold text-sm">
                      {b.pricingStarting.isApproximate ? `约¥${b.pricingStarting.monthlyEquivalent}/月` : `¥${b.pricingStarting.amount}/${b.pricingStarting.period}`}
                    </span>
                  </div>
                  <div>
                    <span class="text-[10px] text-obs-muted block">下行实测快照</span>
                    <span class={maxSpeed > 0 ? 'text-sky-400 font-bold text-sm' : 'text-obs-muted/60 text-sm'}>
                      {maxSpeed > 0 ? `${maxSpeed} Mbps` : '待实测核验'}
                    </span>
                  </div>
                </div>

                <div class="text-[11px] text-obs-muted leading-relaxed line-clamp-2">
                  {b.features?.[0] || '支持主流协议与全平台订阅客户端，节点覆盖主流跨境核心机房。'}
                </div>
              </div>

              <div class="pt-2 space-y-2">
                <div class="flex items-center gap-2">
                  <a
                    href={`/brands/${b.id}/`}
                    class="flex-1 text-center py-2 rounded-lg bg-obs-bg border border-obs-border hover:border-obs-muted text-xs font-mono text-obs-text transition"
                  >
                    查看事实档案
                  </a>
                  {aff.url ? (
                    <a
                      href={aff.url}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="flex-1 text-center py-2 rounded-lg bg-sky-500 hover:bg-sky-400 text-obs-bg font-bold text-xs font-mono transition shadow-md shadow-sky-500/20"
                    >
                      直达官网 &rarr;
                    </a>
                  ) : (
                    <span class="flex-1 text-center py-2 rounded-lg bg-obs-bg/50 border border-obs-border/50 text-[11px] text-obs-muted">
                      暂无独立入口
                    </span>
                  )}
                </div>
                <div class="text-[10px] font-mono text-obs-muted/70 text-center">
                  透明披露：包含赞助推广参数 · 价格与官方一致 · 遵循客观核验
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 8. Contextual Interactive Tool Embed -->
    <section class="space-y-4">
      <div class="border-b border-obs-border pb-3">
        <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-sky-400 rounded-sm"></span>
          配套专业交互诊断工具
        </h2>
        <p class="text-xs text-obs-muted">结合当前专题工程指标，即时在浏览器端运算与模拟排障</p>
      </div>

      {article.parentRoute === '/recommend/' && <RequirementSelector />}
      {article.parentRoute === '/stable/' && <MetricCalculator />}
      {article.parentRoute === '/lab/' && <BandwidthConverter />}
      {article.parentRoute === '/troubleshoot/' && <TroubleshootTree />}
      {article.parentRoute === '/lines/' && <NetworkPathDiagram />}
      {article.parentRoute === '/reviews/' && <TwoBrandCompare />}
      {article.parentRoute === '/free/' && <BrandFilter />}
      {article.parentRoute === '/status/' && <TroubleshootTree />}
    </section>

    <!-- 9. Sibling Articles in Same Cluster -->
    {siblingArticles.length > 0 && (
      <section class="space-y-4">
        <div class="border-b border-obs-border pb-3 flex items-center justify-between">
          <h2 class="text-lg font-bold text-obs-text flex items-center gap-2">
            <span class="w-1.5 h-4 bg-sky-400 rounded-sm"></span>
            同专题集群深度阅读 ({article.clusterName})
          </h2>
          <span class="text-xs font-mono text-obs-muted">{siblingArticles.length} 篇关联文章</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {siblingArticles.map((sib) => (
            <a
              href={sib.suggestedUrl}
              class="p-4 rounded-xl border border-obs-border bg-obs-panel hover:border-sky-500/50 transition flex flex-col justify-between group"
            >
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono text-sky-400 font-bold">{sib.id}</span>
                  <span class="text-[10px] font-mono text-obs-muted">{sib.searchIntent}</span>
                </div>
                <h3 class="text-xs font-bold text-obs-text group-hover:text-sky-300 transition line-clamp-2 leading-snug">
                  {sib.title}
                </h3>
              </div>
              <span class="text-[10px] font-mono text-obs-muted mt-3 inline-flex items-center gap-1 group-hover:text-sky-400 transition">
                阅读白皮书 &rarr;
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 10. FAQ Section with Schema -->
    <section class="rounded-xl border border-obs-border bg-obs-panel p-6 sm:p-7 space-y-4">
      <div class="border-b border-obs-border pb-3">
        <h2 class="text-base font-bold text-obs-text flex items-center gap-2">
          <span class="w-1.5 h-4 bg-sky-400 rounded-sm"></span>
          专题技术核心答疑 (Engineered FAQ)
        </h2>
      </div>

      <div class="divide-y divide-obs-border/50">
        {articleFaqs.map((faq, idx) => (
          <div class="py-3.5 space-y-2 text-xs">
            <h3 class="font-bold text-obs-text flex items-start gap-2">
              <span class="text-sky-400 font-mono font-bold">Q{idx + 1}:</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-obs-muted leading-relaxed pl-5">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Upstream Channel Footnote -->
    <footer class="pt-6 border-t border-obs-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
      <a href={article.parentRoute} class="text-sky-400 hover:underline">
        &larr; 返回 {article.parentCategory} 频道总览
      </a>
      <a href="/brands/" class="text-obs-muted hover:text-obs-text transition">
        查阅 41 个品牌事实数据库 &rarr;
      </a>
    </footer>

  </article>
</BaseLayout>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const { title, description, canonicalUrl, ogType, schema } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="bg-[#0B1220] text-[#E6EDF6]">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogType={ogType}
      schema={schema}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#0B1220] text-[#E6EDF6] selection:bg-[#38BDF8]/20 selection:text-[#38BDF8]">
    <Header currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>

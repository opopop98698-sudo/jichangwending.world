---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '首页', href: '/' },
  { name: '机场推荐', href: '/recommend/' },
  { name: '稳定机场', href: '/stable/' },
  { name: '免费机场', href: '/free/' },
  { name: '测速实验室', href: '/lab/' },
  { name: '线路研究', href: '/lines/' },
  { name: '机场状态', href: '/status/' },
  { name: '深度评测', href: '/reviews/' },
  { name: '网络排障', href: '/troubleshoot/' }
];
---

<header class="sticky top-0 z-50 bg-[#0B1220]/95 backdrop-blur-md border-b border-[#26354D]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand Logo & Badge -->
      <div class="flex items-center space-x-3">
        <a href="/" class="flex items-center space-x-2.5 group">
          <div class="w-9 h-9 rounded-full border-2 border-sky-400/60 bg-[#111C2E] overflow-hidden shrink-0 group-hover:border-sky-400 transition-colors shadow-md shadow-sky-500/20">
            <img src="/avatar.jpg" alt="头像" class="w-full h-full object-cover" />
          </div>
          <div class="flex flex-col">
            <span class="text-base font-bold tracking-tight text-[#E6EDF6] group-hover:text-white transition-colors">稳定机场指南</span>
            <span class="text-[10px] font-mono text-[#A7B6CC] leading-none">jichangwending.world</span>
          </div>
        </a>
        <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono border border-[#10B981]/30 bg-[#10B981]/10 text-[#10B981]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] mr-1.5 animate-pulse"></span>
          实测数据观测中
        </span>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-2.5 py-1.5 rounded text-[13px] font-medium transition-colors ${
                isActive
                  ? 'bg-[#17253D] text-[#38BDF8] font-semibold border border-[#38BDF8]/30'
                  : 'text-[#A7B6CC] hover:text-[#E6EDF6] hover:bg-[#111C2E]'
              }`}
            >
              {item.name}
            </a>
          );
        })}
        <a
          href="/brands/"
          class="ml-2 px-3 py-1.5 rounded text-[12px] font-mono font-medium border border-[#38BDF8]/40 bg-[#38BDF8]/10 text-[#38BDF8] hover:bg-[#38BDF8]/20 transition-colors"
        >
          41品牌库
        </a>
      </nav>

      <!-- Mobile menu button -->
      <div class="flex lg:hidden items-center space-x-2">
        <a
          href="/brands/"
          class="px-2.5 py-1 rounded text-[11px] font-mono border border-[#38BDF8]/40 bg-[#38BDF8]/10 text-[#38BDF8]"
        >
          品牌库
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="打开菜单"
          class="p-2 rounded text-[#A7B6CC] hover:text-white hover:bg-[#111C2E] border border-[#26354D]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-[#26354D] bg-[#0B1220]/98 px-4 pt-2 pb-4 space-y-1">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-3 py-2 rounded text-sm font-medium ${
            isActive ? 'bg-[#17253D] text-[#38BDF8] font-bold' : 'text-[#A7B6CC] hover:bg-[#111C2E] hover:text-white'
          }`}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>

---
import brandsData from '../../data/brands.json';

interface Props {
  initialBrandA?: string;
  initialBrandB?: string;
}

const { initialBrandA = 'lightspeed', initialBrandB = 'weifeng' } = Astro.props;

const bA = brandsData.find((b) => b.id === initialBrandA) || brandsData[0];
const bB = brandsData.find((b) => b.id === initialBrandB) || brandsData[1];
---

<div class="rounded-xl border border-[#26354D] bg-[#111C2E] p-5 sm:p-6 text-[#E6EDF6] space-y-5 my-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#26354D] gap-2">
    <div class="flex items-center space-x-2">
      <span class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></span>
      <h3 class="text-sm sm:text-base font-bold tracking-tight">两品牌资料即时对照 (Two-Brand Comparator)</h3>
    </div>
    <span class="text-xs font-mono text-[#A7B6CC]">支持 41 个品牌任意同条件比对</span>
  </div>

  <!-- Selectors Bar -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="space-y-1.5">
      <label for="select-brand-a" class="block text-xs font-mono text-[#38BDF8] font-semibold">候选品牌 A：</label>
      <select
        id="select-brand-a"
        class="w-full bg-[#0B1220] border border-[#26354D] rounded px-3 py-2 text-xs font-mono text-[#E6EDF6] focus:border-[#38BDF8] focus:outline-none"
      >
        {brandsData.map((b) => (
          <option value={b.id} selected={b.id === bA.id}>
            {b.isTop10 ? `[Top${b.editorialOrder}] ` : ''}{b.name} (¥{b.pricingStarting.monthlyEquivalent}/月起)
          </option>
        ))}
      </select>
    </div>

    <div class="space-y-1.5">
      <label for="select-brand-b" class="block text-xs font-mono text-[#10B981] font-semibold">候选品牌 B：</label>
      <select
        id="select-brand-b"
        class="w-full bg-[#0B1220] border border-[#26354D] rounded px-3 py-2 text-xs font-mono text-[#E6EDF6] focus:border-[#10B981] focus:outline-none"
      >
        {brandsData.map((b) => (
          <option value={b.id} selected={b.id === bB.id}>
            {b.isTop10 ? `[Top${b.editorialOrder}] ` : ''}{b.name} (¥{b.pricingStarting.monthlyEquivalent}/月起)
          </option>
        ))}
      </select>
    </div>
  </div>

  <!-- Comparison Grid Display (Pre-rendered for Bot SEO & Hydrated via JS) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
    <!-- Brand A Column -->
    <div id="col-brand-a" class="p-4 rounded-lg bg-[#0B1220] border border-[#38BDF8]/30 space-y-3 text-xs">
      <div class="flex items-center justify-between pb-2 border-b border-[#26354D]">
        <div>
          <span class="text-sm font-bold text-[#E6EDF6]" id="name-a">{bA.name}</span>
          {bA.isTop10 && <span class="ml-2 text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30" id="badge-a">编辑推荐 #{bA.editorialOrder}</span>}
        </div>
        <div class="font-mono font-bold text-[#38BDF8]" id="price-a">
          {bA.pricingStarting.isApproximate ? '约 ' : ''}¥{bA.pricingStarting.monthlyEquivalent}/月起
        </div>
      </div>
      <div class="space-y-1.5 text-xs font-mono">
        <div><span class="text-[#64748B]">起步套餐:</span> <span class="text-[#E6EDF6]" id="plan-a">{bA.pricingStarting.period} ¥{bA.pricingStarting.amount} ({bA.pricingStarting.trafficGB}GB/月)</span></div>
        <div><span class="text-[#64748B]">线路声明:</span> <span class="text-[#E6EDF6]" id="line-a">{bA.lineType.slice(0, 24)}</span></div>
        <div><span class="text-[#64748B]">协议支持:</span> <span class="text-[#E6EDF6]" id="proto-a">{bA.protocols.join('/')}</span></div>
        <div><span class="text-[#64748B]">客户端支持:</span> <span class="text-[#E6EDF6]" id="client-a">{bA.clients.customApp && bA.clients.thirdParty ? '自研客户端 + 通用Clash' : (bA.clients.customApp ? '专属客户端免配' : '通用订阅导入')}</span></div>
      </div>
      <div class="pt-3 border-t border-[#26354D] flex items-center space-x-2">
        <a id="link-profile-a" href={`/brands/${bA.id}/`} class="flex-1 py-1 px-2 rounded text-center text-xs font-mono bg-[#17253D] hover:bg-[#26354D] border border-[#26354D] text-[#E6EDF6]">
          查看事实档案
        </a>
        {bA.affiliateUrl ? (
          <a id="link-aff-a" href={bA.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="flex-1 py-1 px-2 rounded text-center text-xs font-mono font-bold bg-[#38BDF8] text-[#0B1220] hover:bg-[#38BDF8]/90">
            官网入口
          </a>
        ) : (
          <span id="link-aff-a" class="flex-1 py-1 px-2 rounded text-center text-xs font-mono text-[#64748B] bg-[#111C2E] border border-[#26354D]">无独立入口</span>
        )}
      </div>
    </div>

    <!-- Brand B Column -->
    <div id="col-brand-b" class="p-4 rounded-lg bg-[#0B1220] border border-[#10B981]/30 space-y-3 text-xs">
      <div class="flex items-center justify-between pb-2 border-b border-[#26354D]">
        <div>
          <span class="text-sm font-bold text-[#E6EDF6]" id="name-b">{bB.name}</span>
          {bB.isTop10 && <span class="ml-2 text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#38BDF8]/10 text-[#38BDF8] border border-[#38BDF8]/30" id="badge-b">编辑推荐 #{bB.editorialOrder}</span>}
        </div>
        <div class="font-mono font-bold text-[#10B981]" id="price-b">
          {bB.pricingStarting.isApproximate ? '约 ' : ''}¥{bB.pricingStarting.monthlyEquivalent}/月起
        </div>
      </div>
      <div class="space-y-1.5 text-xs font-mono">
        <div><span class="text-[#64748B]">起步套餐:</span> <span class="text-[#E6EDF6]" id="plan-b">{bB.pricingStarting.period} ¥{bB.pricingStarting.amount} ({bB.pricingStarting.trafficGB}GB/月)</span></div>
        <div><span class="text-[#64748B]">线路声明:</span> <span class="text-[#E6EDF6]" id="line-b">{bB.lineType.slice(0, 24)}</span></div>
        <div><span class="text-[#64748B]">协议支持:</span> <span class="text-[#E6EDF6]" id="proto-b">{bB.protocols.join('/')}</span></div>
        <div><span class="text-[#64748B]">客户端支持:</span> <span class="text-[#E6EDF6]" id="client-b">{bB.clients.customApp && bB.clients.thirdParty ? '自研客户端 + 通用Clash' : (bB.clients.customApp ? '专属客户端免配' : '通用订阅导入')}</span></div>
      </div>
      <div class="pt-3 border-t border-[#26354D] flex items-center space-x-2">
        <a id="link-profile-b" href={`/brands/${bB.id}/`} class="flex-1 py-1 px-2 rounded text-center text-xs font-mono bg-[#17253D] hover:bg-[#26354D] border border-[#26354D] text-[#E6EDF6]">
          查看事实档案
        </a>
        {bB.affiliateUrl ? (
          <a id="link-aff-b" href={bB.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" class="flex-1 py-1 px-2 rounded text-center text-xs font-mono font-bold bg-[#10B981] text-[#0B1220] hover:bg-[#10B981]/90">
            官网入口
          </a>
        ) : (
          <span id="link-aff-b" class="flex-1 py-1 px-2 rounded text-center text-xs font-mono text-[#64748B] bg-[#111C2E] border border-[#26354D]">无独立入口</span>
        )}
      </div>
    </div>
  </div>
</div>

<script define:vars={{ brandsData }}>
  const selectA = document.getElementById('select-brand-a');
  const selectB = document.getElementById('select-brand-b');

  function updateColumn(prefix, brand) {
    if (!brand) return;
    const nameEl = document.getElementById('name-' + prefix);
    const priceEl = document.getElementById('price-' + prefix);
    const planEl = document.getElementById('plan-' + prefix);
    const lineEl = document.getElementById('line-' + prefix);
    const protoEl = document.getElementById('proto-' + prefix);
    const clientEl = document.getElementById('client-' + prefix);
    const linkProfEl = document.getElementById('link-profile-' + prefix);
    const linkAffEl = document.getElementById('link-aff-' + prefix);

    if (nameEl) nameEl.textContent = brand.name;
    if (priceEl) priceEl.textContent = (brand.pricingStarting.isApproximate ? '约 ' : '') + '¥' + brand.pricingStarting.monthlyEquivalent + '/月起';
    if (planEl) planEl.textContent = brand.pricingStarting.period + ' ¥' + brand.pricingStarting.amount + ' (' + brand.pricingStarting.trafficGB + 'GB/月)';
    if (lineEl) lineEl.textContent = brand.lineType.slice(0, 24);
    if (protoEl) protoEl.textContent = brand.protocols.join('/');
    if (clientEl) clientEl.textContent = brand.clients.customApp && brand.clients.thirdParty ? '自研客户端 + 通用Clash' : (brand.clients.customApp ? '专属客户端免配' : '通用订阅导入');
    
    if (linkProfEl) {
      linkProfEl.setAttribute('href', '/brands/' + brand.id + '/');
    }

    if (linkAffEl) {
      if (brand.affiliateUrl) {
        linkAffEl.outerHTML = '<a id="link-aff-' + prefix + '" href="' + brand.affiliateUrl + '" target="_blank" rel="nofollow sponsored noopener" class="flex-1 py-1 px-2 rounded text-center text-xs font-mono font-bold bg-[#38BDF8] text-[#0B1220] hover:bg-[#38BDF8]/90">官网入口</a>';
      } else {
        linkAffEl.outerHTML = '<span id="link-aff-' + prefix + '" class="flex-1 py-1 px-2 rounded text-center text-xs font-mono text-[#64748B] bg-[#111C2E] border border-[#26354D]">无独立入口</span>';
      }
    }
  }

  selectA?.addEventListener('change', () => {
    const b = brandsData.find(x => x.id === selectA.value);
    updateColumn('a', b);
  });

  selectB?.addEventListener('change', () => {
    const b = brandsData.find(x => x.id === selectB.value);
    updateColumn('b', b);
  });
</script>

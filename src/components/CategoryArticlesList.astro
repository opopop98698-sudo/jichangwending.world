---
import contentMap from '../data/content-map.json';

interface Props {
  parentRoute: string; // e.g. '/recommend/', '/stable/'
  categoryName: string;
}

const { parentRoute, categoryName } = Astro.props;

// Filter articles for this category
const categoryArticles = contentMap.filter(a => a.parentRoute === parentRoute);

// Group articles by parentTopicName
const groupedTopics: Record<string, typeof categoryArticles> = {};
for (const art of categoryArticles) {
  if (!groupedTopics[art.parentTopicName]) {
    groupedTopics[art.parentTopicName] = [];
  }
  groupedTopics[art.parentTopicName].push(art);
}
---

<section class="space-y-6 pt-6 border-t border-obs-border">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-obs-border pb-4">
    <div>
      <div class="inline-flex items-center gap-2 text-xs font-mono text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2 py-0.5 rounded mb-1">
        <span>● 三级深度专题知识库</span>
        <span>● 覆盖长尾搜索意图</span>
      </div>
      <h2 class="text-xl font-bold text-obs-text">{categoryName} · 三级专题文章名录 ({categoryArticles.length} 篇)</h2>
      <p class="text-xs text-obs-muted">收录该分类下围绕具体网络工程现象、测速实操、避坑选型与故障排查的完整技术专题</p>
    </div>
    <span class="text-xs font-mono text-obs-muted bg-obs-bg px-2.5 py-1 rounded border border-obs-border">
      共 {Object.keys(groupedTopics).length} 个专题集群
    </span>
  </div>

  <div class="space-y-6">
    {Object.entries(groupedTopics).map(([topicName, articles]) => (
      <div class="rounded-xl border border-obs-border bg-obs-panel p-5 space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-obs-border/70">
          <h3 class="text-sm font-bold text-obs-text flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            <span>{topicName}</span>
          </h3>
          <span class="text-[11px] font-mono text-obs-muted">{articles.length} 篇专文</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 pt-1">
          {articles.map((art) => (
            <a
              href={art.suggestedUrl}
              class="p-3 rounded-lg border border-obs-border bg-obs-bg hover:border-sky-500/50 hover:bg-sky-500/5 transition flex flex-col justify-between group"
            >
              <div class="space-y-1">
                <div class="flex items-center justify-between text-[10px] font-mono">
                  <span class="text-sky-400 font-bold">{art.id}</span>
                  <span class="text-obs-muted/70">{art.clusterName}</span>
                </div>
                <h4 class="text-xs font-semibold text-obs-text group-hover:text-sky-300 transition line-clamp-2 leading-snug">
                  {art.title}
                </h4>
              </div>
              <div class="pt-2 text-[10px] font-mono text-obs-muted group-hover:text-sky-400 transition inline-flex items-center gap-1">
                阅读专题正文 &rarr;
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
